# Cline Operator — Environment Variables
#
# Copy to .env and fill in values. Never commit .env.
# All values below are placeholder examples — replace with real values.

# ── GitHub ──────────────────────────────────────────────────────────────
# Personal access token with repo scope (classic) or Contents+RW + PRs+RW + Metadata (fine-grained)
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── LLM provider keys (at least one required for Cline runner) ──────────
# Cline supports Anthropic, OpenAI, DeepSeek, and OpenAI-compatible providers.
# Set whichever key(s) match the models you use. At least one is needed.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cockpit API ─────────────────────────────────────────────────────────
COCKPIT_API_URL=http://api:8080
COCKPIT_API_PORT=8080
COCKPIT_UI_PORT=8081

# ── Planning ────────────────────────────────────────────────────────────
PLANNING_GITHUB_SLUG=sv-copilot/simon-projects
PLANNING_BRANCH=ai-dev
PLANNING_REPO_PATH=/data/planning/simon-projects

# ── Implementation repos ────────────────────────────────────────────────
IMPLEMENTATION_REPO_BASE=/data/repos
# Clone implementation repos under /data/repos/<repo-id> before first run

# ── Cline ───────────────────────────────────────────────────────────────
CLINE_RUNNER_MODE=1
# Cline model selection is runtime — set in automation config or pass via CLI



# ── Optional: Slack/Discord webhook for run notifications ───────────────
# COCKPIT_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/...

# ── Credential broker (Postgres on same VPS — slice #105) ───────────────
# Generate locally: python3 -c "import secrets; print(secrets.token_hex(32))"
# Store in password manager — never commit.
COCKPIT_SECRETS_MASTER_KEY=
# Postgres (container in compose, not external)
COCKPIT_POSTGRES_USER=cockpit
COCKPIT_POSTGRES_PASSWORD=
COCKPIT_POSTGRES_DB=cockpit
# Broker bootstrap: comma-separated env var names to hydrate from broker at startup.
# List the keys your runner actually needs — not all are required.
CREDENTIAL_BOOTSTRAP_REFS=GH_TOKEN
# Inventory environment tier (staging | production | dev)
CREDENTIALS_INVENTORY_ENV=staging
# Allowed CORS origins for the API (UI hostnames)
COCKPIT_CORS_ORIGINS=http://localhost:8081,https://cockpit-staging.spencervaradi.com
# VPN / IP allowlist for credential writes (comma-separated CIDR or IP list)
COCKPIT_VPN_ALLOWLIST=
# Shared secret for credential writes — works from any IP, no VPN needed.
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
# Pass as header: X-Cockpit-Write-Token: <value>
# COCKPIT_WRITE_TOKEN=
# Set to 1 for local dev without VPN; must be 0 on staging
COCKPIT_ALLOW_CREDENTIAL_WRITES=0
# Public base URL of the cockpit API (used by UI runtime config injection)
COCKPIT_API_BASE_URL=https://cockpit-api-staging.spencervaradi.com
# GitHub webhook secret for PR merge → orchestrator trigger
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
# COCKPIT_GITHUB_WEBHOOK_SECRET=

# ── Cloud deploy (Railway staging) ─────────────────────────────────────
# Set these in Railway dashboard, not in local .env.
# See deploy/cline-operator/cloud/README.md for full bring-up guide.
# COCKPIT_CLOUD_URL — auto-assigned by Railway on first deploy
# PLANNING_CHECKOUT_PATH=/data/planning/simon-projects
# QUEUE_PATH=/data/cockpit/queue.json
# RAILWAY_SERVICE_NAME=cockpit-api-staging
